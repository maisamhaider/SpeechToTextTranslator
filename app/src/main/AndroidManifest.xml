<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.speechtotexttranslator">
    <!-- permission for voice recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" />

    <application
        android:name=".utils.AppLevel"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpeechToTextTranslator">
        <activity
            android:name=".ui.activities.dictionary.ActivityQuiz"
            android:exported="false" />
      
        <activity
            android:name=".ui.activities.dictionary.ActivityDictionaryTranslate"
            android:exported="false" />
        <activity
            android:name=".ui.activities.dictionary.ActivityDictionaryFavorites"
            android:exported="false" />
        <activity
            android:name=".ui.activities.dictionary.ActivityDictionaryHistory"
            android:exported="false" />
        <activity
            android:name=".ui.activities.dictionary.ActivityDictionaryResult"
            android:exported="false" />
        <activity
            android:name=".ui.activities.dictionary.ActivityDictionary"
            android:exported="false" />
        <activity
            android:name=".ui.activities.settings.ActivitySettings"
            android:exported="false" />
        <activity
            android:name=".ui.activities.usefullphrases.ActivityUseFullPhrasesFavorites"
            android:exported="false" />
        <activity
            android:name=".ui.activities.usefullphrases.ActivityUseFullPhrasesResult"
            android:exported="false" />
        <activity
            android:name=".ui.activities.usefullphrases.ActivityUseFullPhrases"
            android:exported="false"
            android:label="@string/title_activity_use_full_phrases"
            android:theme="@style/Theme.SpeechToTextTranslator.NoActionBar" />
        <activity
            android:name=".ui.activities.cameratranslator.ActivityCameraTranslatorResult"
            android:exported="true" />
        <activity
            android:name=".ui.activities.cameratranslator.ActivityCrop"
            android:exported="true" />
        <activity
            android:name=".ui.activities.cameratranslator.ActivityCameraTranslator"
            android:exported="true" />
        <activity
            android:name=".ui.activities.speechtotext.ActivitySpeechToTextNotesList"
            android:exported="true" />
        <activity
            android:name=".ui.activities.speechtotext.ActivitySpeechToTextNoteView"
            android:exported="true" />
        <activity
            android:name=".ui.activities.speechtotext.ActivitySpeechToText"
            android:exported="true" />
        <activity
            android:name=".ui.activities.voicetranslate.ActivityVoiceTranslatorHistoriesList"
            android:exported="true" />
        <activity
            android:name=".ui.activities.voicetranslate.ActivityVoiceTranslatorFavoritesList"
            android:exported="true" />
        <activity
            android:name=".ui.activities.voicetranslate.ActivityVoiceTranslatorResult"
            android:exported="true" />
        <activity
            android:name=".ui.activities.voicetranslate.ActivityVoiceTranslator"
            android:exported="true" />
        <activity
            android:name=".ui.activities.ActivitySpeakAndTranslate"
            android:exported="true" />
        <activity
            android:name=".ui.activities.ActivityLanguages"
            android:exported="true" />
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.activities.ActivityOfflineTranslator"
            android:exported="true" />
        <activity
            android:name="com.theartofdev.edmodo.cropper.CropImageActivity"
            android:theme="@style/Base.Theme.AppCompat" /> <!-- Declares the input method service -->

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>

</manifest>